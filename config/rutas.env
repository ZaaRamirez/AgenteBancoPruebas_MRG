#  RUTAS EXTERNAS. El banco de pruebas NO guarda modelos: aqui solo se indica
#  donde ya estan en esta computadora. Edita este archivo UNA vez.
#  Formato bash (VARIABLE="valor"). Lo leen entorno.sh y el propio agente.

# ROS 2 -
ROS_SETUP="/opt/ros/jazzy/setup.bash"

# Ollama (LLM y VLM)
# El agente solo necesita la URL del servidor; no importa donde esten los modelos.
OLLAMA_URL="http://localhost:11434"

# Entorno de Python con torch + LeRobot (MolmoAct2) 
# Comando que activa el entorno donde YA corre molmo_ros_bridge.py (importa
# rclpy, torch y lerobot). Vacio = usar el python3 del sistema. Ejemplos:
#   PY_ENV_ACTIVATE="source $HOME/Projects/MolmoAct/LeRobotMolmo/LeRobotMolmo/bin/activate"
PY_ENV_ACTIVATE="source $HOME/Projects/MolmoAct/LeRobotMolmo/LeRobotMolmo/bin/activate"

# Modelos locales (los usa config/modelos.yaml)
LEROBOT_DIR="$HOME/Projects/MolmoAct/LeRobotMolmo"
# Backbone VLM de MolmoAct2 (percepcion con transformers)
MOLMO_VLM_PATH="$LEROBOT_DIR/models/MolmoAct2"
# Politica MolmoAct2 ajustada al OMX (ejecucion con LeRobot)
MOLMO_OMX_CKPT="$LEROBOT_DIR/lerobot-src/outputs/molmoact2_omx_banana/checkpoints/001000/pretrained_model"
# Politica MolmoAct2 para el bimanual SO-101 (cuando exista)
MOLMO_SO101_CKPT=""
